# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is the "anon" / "publishable" key — safe to ship in the
# frontend bundle (Row Level Security on the tables is what actually gates access).
# NEVER put the service_role / secret key here or in any file committed to git.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# In Vercel: Project Settings -> Environment Variables -> add both of the above
# (for Production, Preview, and Development), then redeploy.
